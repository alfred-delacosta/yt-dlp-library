PORT=
ENVIRONMENT=
ARGON2_SECRET=
JWT_SECRET=
ACCESS_TOKEN_SECRET=
# Refresh session lifetime in days. The refresh cookie uses this same value.
JWT_NUMBER_OF_DAYS_EXPIRATION=
# Access token lifetime in minutes.
ACCESS_TOKEN_NUMBER_OF_MINUTES_EXPIRATION=
# Unused. The refresh cookie lifetime follows JWT_NUMBER_OF_DAYS_EXPIRATION.
COOKIE_EXPIRATION_TIME_IN_HOURS=
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=
JELLYFIN_FOLDER_PATH=
WHISPER_X_API_URL=
BROWSER=
# Playwright cookie harvest (cookieSource=harvest): uses installed Google Chrome via channel chrome.
# Set to 1 to show the Chrome window while harvesting (debug). Default is headless.
PLAYWRIGHT_HEADED=
# Milliseconds to wait after play attempt before exporting cookies (default 5000).
COOKIE_HARVEST_SETTLE_MS=
# Navigation timeout for harvest in milliseconds (default 45000).
COOKIE_HARVEST_TIMEOUT_MS=
ENABLE_LEGACY_UPDATE=